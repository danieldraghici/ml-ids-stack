# Copy to .env (git-ignored). Ports and hostnames live here, never in compose.yaml.
# Every published port binds to 127.0.0.1 only (see compose.yaml).
OPENSEARCH_PORT=9200
# Dashboards is reached only through the TLS front door: https://localhost:8443
HTTPS_PORT=8443
# Grafana is reached through the same front door: https://localhost:8443/grafana/
# Prometheus and Alertmanager UIs, on 127.0.0.1 only (F7, R-06)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# The detector service writes out/ as this user, so the files stay yours: id -u, id -g
DETECTOR_UID=1000
DETECTOR_GID=1000
