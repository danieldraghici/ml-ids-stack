{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.secrets)",
      "Read(**/*.agekey)",
      "Read(**/keys.txt)",
      "Read(./certs/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./.github/rulesets/**)",
      "Edit(./detector/thresholds.json)",
      "Edit(./models/**)",
      "Edit(./tests/regression/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
